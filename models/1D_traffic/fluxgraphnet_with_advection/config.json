{
  "batch_size": 256,
  "data": "data/lwr_structured_directional",
  "device": "cuda",
  "dropout": 0.1,
  "epochs": 1000,
  "flux_loss_weight": 10.0,
  "hidden_channels": 128,
  "layer_norm": false,
  "learning_rate": 0.0001,
  "log_every": 10,
  "mass_projection": false,
  "model": "fluxgraphnet",
  "node_weight_loss": 1.0,
  "num_layers": 4,
  "num_workers": 4,
  "output": "runs/structured_directional/fluxgraphnet/with_advection/1000ep_lr-1e-4_10p0-flux-loss-weight_pred-rate",
