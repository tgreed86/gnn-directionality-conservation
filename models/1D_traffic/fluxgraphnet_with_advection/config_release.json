{
  "data": "datasets/1D_traffic/lwr_structured_directional",
  "output": "outputs/1D_traffic/fluxgraphnet_with_advection",
  "model": "fluxgraphnet",
  "target_type": "rate",
  "physics_inputs": {
    "enabled": true,
    "include_adv": true,
    "input_form": "rate",
    "advection_scheme": "godunov",
    "adv_all_steps": true,
    "input_weighted": false,
    "adv_weight": 1.0,
    "normalize_adv_to_minus1_1": false,
    "adv_min": null,
    "adv_max": null,
    "normalize_adv_clip": false,
    "detach_inputs": true
  },
  "epochs": 1000,
  "batch_size": 256,
  "training_rollout_steps": 1,
  "hidden_channels": 128,
  "layer_norm": false,
  "mass_projection": false,
  "num_layers": 4,
  "dropout": 0.1,
  "learning_rate": 0.0001,
  "weight_decay": 0,
  "node_weight_loss": 1.0,
  "flux_loss_weight": 10.0,
  "train_fraction": 0.7,
  "validation_fraction": 0.15,
  "test_fraction": 0.15,
  "patience": 0,
  "num_workers": 4,
  "device": "cuda",
  "seed": 1234,
  "log_every": 10
}
