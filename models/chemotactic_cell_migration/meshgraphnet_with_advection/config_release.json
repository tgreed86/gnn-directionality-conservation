{
  "data": "datasets/chemotactic_cell_migration/unique_meshes_17x17",
  "output": "outputs/chemotactic_cell_migration/meshgraphnet_with_advection",
  "model": "meshgraphnet",
  "target_type": "delta",
  "physics_inputs": {
    "enabled": true,
    "include_adv": true,
    "input_form": "delta",
    "advection_scheme": "upwind",
    "adv_all_steps": true,
    "input_weighted": false,
    "adv_weight": 1.0,
    "normalize_adv_to_minus1_1": false,
    "adv_min": null,
    "adv_max": null,
    "normalize_adv_clip": false,
    "detach_inputs": true
  },
  "node_loss_normalization": "target",
  "node_density_weighting": "target",
  "node_density_weight_strength": 0.25,
  "autoregressive_steps": 5,
  "epochs": 500,
  "batch_size": 16,
  "hidden_channels": 128,
  "num_layers": 4,
  "dropout": 0.1,
  "layer_norm": false,
  "include_chi": false,
  "include_drift_velocity": true,
  "include_absolute_positions": true,
  "include_boundary_distances": false,
  "mass_projection": false,
  "decode_normalized_flux": true,
  "flux_decoder_edge_features": "processed",
  "antisymmetric_flux_decoder": true,
  "learning_rate": 5e-05,
  "weight_decay": 1e-05,
  "node_weight_loss": 1.0,
  "flux_loss_weight": 0.0,
  "flux_supervision_steps": "first",
  "gradient_clip_norm": 1.0,
  "train_fraction": 0.7,
  "validation_fraction": 0.15,
  "test_fraction": 0.15,
  "early_stopping_metric": "normalized_mse",
  "patience": 50,
  "num_workers": 4,
  "device": "cuda",
  "seed": 1234,
  "log_every": 10
}
